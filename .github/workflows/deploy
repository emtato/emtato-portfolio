# This is a basic workflow to help you get started with Actions

name: Deploy to GitHub Pages

# Controls when the workflow will run
on:
  # Triggers the workflow on push or pull request events but only for the "main" branch
  push:
    branches: [ "main" ]

  # Allows you to run this workflow manually from the Actions tab
  workflow_dispatch:

permissions: #controls what this workflow is allowed to do in your repository
  contents: read #read project files
  pages: write #allows it to publish a new version of your GitHub Pages site.
  id-token: write

# A workflow run is made up of one or more jobs that can run sequentially or in parallel
jobs:
  deploy: #job's id
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}

    runs-on: ubuntu-latest #create a clean Linux computer for the job (run the comands)

    steps:
      - name: Checkout repository
        uses: actions/checkout@v6
      - name: Set up Node.js
        uses: actions/setup-node@v7
        with:
          node-version: lts
          cache: npm
      - name: Install dependencies
        run: npm ci #npm install, except cannot rewrite package-lock: just purely installs dependencies 
      - name: Build website
        run: npm run build
      - name: Set up GitHub Pages #built (in /dist), now upload it from computer to ghp
        uses: actions/configure-pages@v6
      - name: Upload built website
        uses: actions/upload-pages-artifact@v5
        with:
          path: "./dist"
      - name: Deploy website
        id: deployment
        uses: actions/deploy-pages@v5
